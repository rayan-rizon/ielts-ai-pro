# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public Google OAuth web client used by the Google sign-in flow.
# It must match the Google provider configured in Supabase and allow the local
# development callback (for example, http://localhost:5173/login).
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# AI Configuration
GEMINI_API_KEY=your-gemini-api-key

# Optional Web Push delivery. Permission is requested only after a learner opts in.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:support@ieltsai.pro
VITE_WEB_PUSH_PUBLIC_KEY=

# Vercel AI Gateway
AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_QUARTERLY_PRICE_ID=price_...
STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_...
STRIPE_PREMIUM_QUARTERLY_PRICE_ID=price_...

# Nagad Online Payment (Edge Function secrets). See docs/nagad-payments.md.
# Keys may be the bare base64 Nagad sends or full PEM. Never commit real keys.
NAGAD_BASE_URL=http://sandbox.mynagad.com:30001
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_PG_PUBLIC_KEY=
NAGAD_RECONCILE_SECRET=
# Local only: where Nagad sends the browser back (defaults to the deployed
# nagad-callback function) and where that function then redirects.
# NAGAD_CALLBACK_URL=http://127.0.0.1:8787/functions/v1/nagad-callback
# FRONTEND_URL=http://localhost:5173
# Optional: 'sandbox' or 'live'. Defaults from NAGAD_BASE_URL. Sandbox is
# admin-only and never grants a plan.
# NAGAD_ENVIRONMENT=sandbox

# Cloudflare R2 Storage (Required for Media)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_AI_API_TOKEN=your-cloudflare-workers-ai-token
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=your-azure-region
# Optional override; otherwise https://<region>.stt.speech.microsoft.com is used.
AZURE_SPEECH_ENDPOINT=
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=ielts-ai-media
R2_PUBLIC_URL=https://media.ieltsai.pro
VITE_R2_PUBLIC_URL=https://media.ieltsai.pro
# Practice-mode coach voice (synthesizePracticeSpeech). On by default; the server
# PRACTICE_TTS_ROLLOUT secret decides who gets it. "off" is a build-time kill switch.
VITE_PRACTICE_TTS=

# Sentry Configuration
VITE_SENTRY_DSN=

# PostHog product analytics (automatic on production hosts, matching GTM/Meta)
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_UI_HOST=https://us.posthog.com
# Opt in only for local verification; never enable this in production.
VITE_POSTHOG_ENABLE_DEVELOPMENT=false
# Server-side AI Observability for Supabase Edge Functions. Captures metadata only;
# prompts, answers, and conversation session IDs are not sent.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Meta (Facebook) Advertising
# VITE_META_PIXEL_ID is optional; tracking.js falls back to the hardcoded pixel.
VITE_META_PIXEL_ID=
# Server-side Conversions API relay (api/meta-capi.js). Without the token the
# endpoint no-ops with a 204 and only browser-side Pixel events are sent.
# Generate the token in Events Manager > Settings > Conversions API.
# META_PIXEL_ID is optional; the relay defaults to the site pixel.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Set only while validating in Events Manager > Test Events; remove afterwards.
META_TEST_EVENT_CODE=

# Private paired practice is visible in the app. The Edge Function secret is the emergency kill switch.
# Edge Function secret (set separately): PAIRED_TESTS_ENABLED=true

# Local testing of changed Edge Functions without Docker (npm run edge:local).
# Dev server only: the listed functions go to the local Deno server, the rest
# to the hosted project. Leave unset normally.
# LOCAL_EDGE_FUNCTIONS_URL=http://127.0.0.1:8787
# LOCAL_EDGE_FUNCTIONS=processSpeakingSessionV2,synthesizePracticeSpeech
