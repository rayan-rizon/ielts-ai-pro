  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run seo:static && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "playwright test",
    "test:unit": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "format": "prettier --write .",
    "seo:static": "node scripts/generate-static-seo-pages.mjs",
    "analyze": "npx vite-bundle-visualizer",
    "gen:types": "npx supabase gen types typescript --linked > src/types/supabase.types.ts",
    "perf:lighthouse:mobile": "lhci collect --settings.emulatedFormFactor=mobile",
    "perf:lighthouse:desktop": "lhci collect --settings.emulatedFormFactor=desktop",
    "perf:lighthouse:assert": "lhci assert",
    "precache-tts": "node scripts/pre-cache-tts.mjs",
    "prepare": "if [ -d .git ]; then husky; fi"
  },
