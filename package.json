  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/patch-sanitize-html-runtime.mjs && vite build && node scripts/generate-public-seo-pages.mjs",
    "seo:check": "node scripts/check-public-seo.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:production": "npm run build && node scripts/preview-production-routes.mjs",
    "test": "playwright test",
    "test:unit": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "format": "prettier --write .",
    "analyze": "npx vite-bundle-visualizer",
    "performance:critical-css": "node scripts/generate-landing-critical-css.mjs",
    "gen:types": "npx supabase gen types typescript --linked > src/types/supabase.types.ts",
    "perf:lighthouse:mobile": "lhci collect --settings.emulatedFormFactor=mobile",
    "perf:lighthouse:desktop": "lhci collect --settings.emulatedFormFactor=desktop",
    "perf:lighthouse:assert": "lhci assert",
    "precache-tts": "node scripts/pre-cache-tts.mjs",
    "compare:text-ai": "node --experimental-strip-types scripts/compare-text-ai-providers.mjs",
    "prepare": "if [ -d .git ]; then husky; fi"
  },
