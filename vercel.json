    {
      "source": "/page-sitemap.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/news-sitemap.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/sitemaps.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/sitemap1.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/ielts-mock-test-online",
      "destination": "/cambridge-ielts-practice-tests",
      "permanent": true
    },
    {
      "source": "/free-ielts-practice-tests",
