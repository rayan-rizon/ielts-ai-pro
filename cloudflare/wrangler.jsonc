{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ielts-ai-pro",
  "account_id": "8814fe480ca632794b5f4fa007b4b166",
  "main": "worker.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "assets": {
    "directory": "./dist-production",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/fonts/*",
      "!/speaking-assets/*"
    ]
  },
  "vars": {
    "DEPLOYMENT_STAGE": "production"
  },
  "ratelimits": [
    {
      "name": "META_CAPI_RATE_LIMITER",
      "namespace_id": "991226963",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
