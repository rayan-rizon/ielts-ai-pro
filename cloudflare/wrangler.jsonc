{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ielts-ai-cloudflare-staging",
  "account_id": "8814fe480ca632794b5f4fa007b4b166",
  "main": "worker.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/fonts/*",
      "!/speaking-assets/*"
    ]
  },
  "vars": {
    "DEPLOYMENT_STAGE": "staging"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
